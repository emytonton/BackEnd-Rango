# Copie para .env e ajuste se necessário. Todos os valores têm default de desenvolvimento.
NODE_ENV=development
PORT=3333
HOST=0.0.0.0

# SQLite: caminho do arquivo (use :memory: para banco descartável)
DATABASE_PATH=./data/rango.db

# Diretório onde as fotos de perfil são gravadas
UPLOAD_DIR=./uploads

# Segredo do JWT (troque em qualquer ambiente compartilhado)
JWT_SECRET=dev-only-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TTL_DAYS=1
REFRESH_TTL_DAYS_KEEP_SIGNED_IN=30

# Origens permitidas no CORS (separadas por vírgula; * libera todas)
CORS_ORIGINS=*

# Regras de negócio (valores do protótipo)
DELIVERY_FEE=7.9
FREE_DELIVERY_THRESHOLD=60
# Segundos entre cada etapa da simulação do pedido (0 desliga a progressão automática)
ORDER_STEP_SECONDS=20

# Em desenvolvimento a API devolve o token de redefinição de senha na resposta (não há envio de e-mail)
EXPOSE_RESET_TOKEN=true
